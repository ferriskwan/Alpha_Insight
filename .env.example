# Environment & Runtime
ENV=DEV
PORT=8080
API_URL=http://localhost:8080
API_KEY=your-api-key-here

# Database Configuration (PostgreSQL Cloud SQL / Local)
DB_HOST=
DB_PUBLIC_IP=127.0.0.1
DB_PORT=5432
DB_NAME=4leafclover_dev
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_SSLMODE=prefer
DATABASE_URL=

# Authentication & Sessions
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPERADMIN_EMAIL=your-email@example.com
SESSION_COOKIE_NAME=alpha_sid
SESSION_TTL_DAYS=7

# External Market Data & AI Model Providers
TWELVEDATA_API_KEY=your-twelvedata-api-key
TWELVEDATA_BASE_URL=https://api.twelvedata.com/time_series
GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-4-argon
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
