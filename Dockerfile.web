# syntax=docker/dockerfile:1.4
# Stage 1: Build React 19 Frontend
FROM node:20-slim AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci || npm install

COPY frontend/ ./
RUN npm run build || mkdir -p dist

# Stage 2: Python Backend Runtime
FROM python:3.11-slim AS runtime

# System runtime dependencies for psycopg2 and matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv for rapid Python dependency resolution
RUN pip install --no-cache-dir uv

WORKDIR /app

# Copy dependency configuration
COPY pyproject.toml ./
RUN uv pip install --system -r pyproject.toml || pip install --no-cache-dir fastapi uvicorn pydantic-settings psycopg2-binary sqlalchemy requests yfinance matplotlib mplfinance mplcursors

# Copy application source code
COPY *.py ./
COPY backend/ ./backend/
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Non-root security user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV PORT=8080 \
    PYTHONUNBUFFERED=1 \
    ENV=PRD

EXPOSE 8080

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
