{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "react-dom": ["node_modules/@types/react-dom"],
      "vitest": ["node_modules/vitest"],
      "@testing-library/react": ["node_modules/@testing-library/react"],
      "@testing-library/jest-dom/vitest": ["node_modules/@testing-library/jest-dom/vitest"],
      "fs": ["node_modules/@types/node/fs.d.ts"],
      "path": ["node_modules/@types/node/path.d.ts"]
    }
  },
  "include": ["src", "../tests/frontend"]
}
